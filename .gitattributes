# Keep generated numeric/source hashes reproducible on Windows and Unix.
* text=auto eol=lf
*.flac -text
*.mp3 -text
*.png -text
*.ttf -text
*.svg -text -whitespace
# Upstream reference metadata and frozen figures retain their original bytes.
Experiments/Research/** -text -whitespace
Experiments/References/**/upstream/** -text -whitespace
Experiments/third_party/** -text -whitespace
Experiments/src/full_reference/** -text -whitespace
# Generated upstream license payloads must retain their exact bytes, including
# original line endings and whitespace, on every platform.
ThirdParty/JUCE-DEPENDENCY-NOTICES.txt -text -whitespace
