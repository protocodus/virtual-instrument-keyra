# Shared metadata/compile selection for the canonical core and SDK-free adapters.
# Nothing is generated or fitted by CMake; prepared profile headers are tracked.
function(keyra_resolve_full_profile profile output_prefix)
  if(profile STREQUAL "OriginalControl")
    set(profile_id 0)
    set(anchor_count 5)
    set(mode_count 17778)
  elseif(profile STREQUAL "FrozenConfidenceGrand")
    set(profile_id 1)
    set(anchor_count 17)
    set(mode_count 17849)
  else()
    message(FATAL_ERROR "Unknown full model profile '${profile}'; use OriginalControl or FrozenConfidenceGrand")
  endif()
  set(${output_prefix}_ID ${profile_id} PARENT_SCOPE)
  set(${output_prefix}_ANCHORS ${anchor_count} PARENT_SCOPE)
  set(${output_prefix}_STRING_MODES ${mode_count} PARENT_SCOPE)
endfunction()

function(keyra_apply_full_profile target profile_id)
  if(MSVC)
    target_compile_options(${target} PRIVATE /UKEYRA_FULL_MODEL_PROFILE /DKEYRA_FULL_MODEL_PROFILE=${profile_id})
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    # Override any inherited/global definition with this target's explicit choice.
    target_compile_options(${target} PRIVATE -UKEYRA_FULL_MODEL_PROFILE -DKEYRA_FULL_MODEL_PROFILE=${profile_id})
  else()
    target_compile_definitions(${target} PRIVATE KEYRA_FULL_MODEL_PROFILE=${profile_id})
  endif()
endfunction()
