    "source_adaptations": [
      {
        "before": "double cents=std::clamp(lerp(centsA,centsB,cal.t),-25.0,30.0);",
        "after": "double cents=std::clamp(lerp(centsA,centsB,cal.t),-70.0,70.0);",
        "reason": "Allow directly observed TRAIN tuning within the frozen pitch extractor search bounds."
      },
      {
        "before": "explicit Cal(int note){lo=std::clamp((note-36)/12,0,3);hi=lo+1;t=(note-piano_calibration::anchors[lo].note)/12.0;}",
        "after": "explicit Cal(int note){lo=0;hi=1;while(hi+1<(int)piano_calibration::anchors.size()&&note>=piano_calibration::anchors[hi].note){++lo;++hi;}t=(note-piano_calibration::anchors[lo].note)/(double)(piano_calibration::anchors[hi].note-piano_calibration::anchors[lo].note);}",
        "reason": "Use the sorted measured anchor notes and actual semitone distances."
      },
      {
        "before": "if(n<36)k.B=piano_calibration::anchors[0].B*std::pow(2.0,(36-n)/18.0);",
        "after": "if(n<piano_calibration::anchors.front().note)k.B=piano_calibration::anchors.front().B*std::pow(2.0,(piano_calibration::anchors.front().note-n)/18.0);",
        "reason": "Apply bass stiffness extrapolation only outside measured anchors."
      },
      {
        "before": "if(n>84)late*=std::pow(2.0,(n-84)/24.0);",
        "after": "if(n>piano_calibration::anchors.back().note)late*=std::pow(2.0,(n-piano_calibration::anchors.back().note)/24.0);",
        "reason": "Apply treble intrinsic-loss extrapolation only outside measured anchors."
      },
      {
        "before": "if(n>84){late*=std::pow(2.0,(n-84)/24.0);fast*=std::pow(2.0,(n-84)/24.0);}",
        "after": "if(n>piano_calibration::anchors.back().note){late*=std::pow(2.0,(n-piano_calibration::anchors.back().note)/24.0);fast*=std::pow(2.0,(n-piano_calibration::anchors.back().note)/24.0);}",
        "reason": "Apply treble common-unison loss extrapolation only outside measured anchors."
      }
